start: if_stmt

if_stmt: IF condition (THEN action)?
condition: condition_part+
action: action_part+

?condition_part: STRING
               | NAME
               | NUMBER
               | COMPARE_WORD
               | BOOL_WORD
               | SYMBOL_OP
               | COMMA
               | DOT
               | COLON
               | LPAR condition? RPAR
               | LBRACK condition? RBRACK
               | LBRACE condition? RBRACE

?action_part: STRING
            | NAME
            | NUMBER
            | COMPARE_WORD
            | BOOL_WORD
            | SYMBOL_OP
            | COMMA
            | DOT
            | COLON
            | LPAR action? RPAR
            | LBRACK action? RBRACK
            | LBRACE action? RBRACE

IF.5: /(?ai:if)/
THEN.5: /(?ai:then)/
COMPARE_WORD.4: /\b(?ai:eq|ne|gt|lt|ge|le)\b/
BOOL_WORD.4: /\b(?ai:and|or|not)\b/
NAME.1: /[A-Za-z_][\w\.]*/
NUMBER: /(?:\d+\.\d*|\d+|\.\d+)(?:[eE][+-]?\d+)?/
STRING: /'(?:''|[^'])*'|"(?:""|[^"])*"/
SYMBOL_OP: />=|<=|!=|==|\^=|~=|¬=|\|\||\*\*|[-+*\/%^<>=]/
COMMA: ","
DOT: "."
COLON: ":"
LPAR: "("
RPAR: ")"
LBRACK: "["
RBRACK: "]"
LBRACE: "{"
RBRACE: "}"

%import common.WS_INLINE
%ignore WS_INLINE