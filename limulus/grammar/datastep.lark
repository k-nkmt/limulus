// limulus DataStep grammar 

start: statement (";" statement)* ";"?

statement: data_stmt
         | set_stmt
         | merge_stmt
         | if_stmt
         | else_if_stmt
         | else_stmt
         | where_stmt
         | by_stmt
         | output_stmt
         | drop_stmt
         | keep_stmt
         | delete_stmt
         | rename_stmt
         | retain_stmt
         | array_stmt
         | stop_stmt
         | do_stmt
         | end_stmt
         | run_stmt
         | sum_stmt
         | assign_stmt
         | skipped_stmt

// --- Core statements ---
data_stmt: data_kw dataset_ref+
set_stmt: set_kw set_component+
merge_stmt: merge_kw set_component+
data_kw: /[dD][aA][tT][aA]/
set_kw: /[sS][eE][tT]/
merge_kw: /[mM][eE][rR][gG][eE]/
set_component: dataset_ref
          | set_statement_option
dataset_ref: dataset_name dataset_options?
dataset_name: /[A-Za-z_][\w\.]*/
dataset_options: "(" dataset_option+ ")"
dataset_option: /[A-Za-z_][\w]*\s*=\s*(?:\((?:[^()]|\([^()]*\))*\)|"[^"]*"|'[^']*'|[^)\s]+(?:\s+(?![A-Za-z_][\w]*\s*=)[^)\s]+)*)/
set_statement_option: /([iI][nN][dD][sS][nN][aA][mM][eE]|[eE][nN][dD])\s*=\s*[A-Za-z_][\w\.]*/

if_stmt: if_then_do_stmt
    | if_then_stmt
    | subset_if_stmt
else_if_stmt: else_if_then_do_stmt
         | else_if_then_stmt
if_then_do_stmt: /[iI][fF]\b[^;]*\b[tT][hH][eE][nN]\s+[dD][oO]\b[^;]*/
if_then_stmt: /[iI][fF]\b[^;]*\b[tT][hH][eE][nN]\b[^;]*/
subset_if_stmt: /[iI][fF]\b(?![^;]*\b[tT][hH][eE][nN]\b)[^;]*/
else_if_then_do_stmt: /[eE][lL][sS][eE]\s*[iI][fF]\b[^;]*\b[tT][hH][eE][nN]\s+[dD][oO]\b[^;]*/
else_if_then_stmt: /[eE][lL][sS][eE]\s*[iI][fF]\b[^;]*\b[tT][hH][eE][nN]\b[^;]*/
else_stmt: /[eE][lL][sS][eE][^;]*/
where_stmt: /[wW][hH][eE][rR][eE][^;]*/
by_stmt: /[bB][yY][^;]*/
output_stmt: /[oO][uU][tT][pP][uU][tT][^;]*/
drop_stmt: /[dD][rR][oO][pP][^;]*/
keep_stmt: /[kK][eE][eE][pP][^;]*/
delete_stmt: /[dD][eE][lL][eE][tT][eE]/
rename_stmt: /[rR][eE][nN][aA][mM][eE][^;]*/
retain_stmt: /[rR][eE][tT][aA][iI][nN][^;]*/
array_stmt: /[aA][rR][rR][aA][yY][^;]*/
stop_stmt: /[sS][tT][oO][pP]/
do_stmt: /[dD][oO]/ /[^;]+/
end_stmt: /[eE][nN][dD]/
run_stmt: /[rR][uU][nN]/

sum_stmt: /(?!\s*(?:[iI][fF]|[eE][lL][sS][eE]|[wW][hH][eE][rR][eE]|[dD][aA][tT][aA]|[sS][eE][tT]|[mM][eE][rR][gG][eE]|[bB][yY]|[oO][uU][tT][pP][uU][tT]|[dD][rR][oO][pP]|[kK][eE][eE][pP]|[dD][eE][lL][eE][tT][eE]|[rR][eE][nN][aA][mM][eE]|[rR][eE][tT][aA][iI][nN]|[aA][rR][rR][aA][yY]|[sS][tT][oO][pP]|[dD][oO]|[eE][nN][dD]|[rR][uU][nN]|[lL][eE][nN][gG][tT][hH]|[aA][tT][tT][rR][iI][bB]|[fF][oO][rR][mM][aA][tT]|[lL][aA][bB][eE][lL]|[iI][nN][fF][oO][rR][mM][aA][tT])\b)[A-Za-z_][\w\.]*\s*\+\s*[^;]+/
assign_stmt: /(?!\s*(?:[iI][fF]|[eE][lL][sS][eE]|[wW][hH][eE][rR][eE]|[dD][aA][tT][aA]|[sS][eE][tT]|[mM][eE][rR][gG][eE]|[bB][yY]|[oO][uU][tT][pP][uU][tT]|[dD][rR][oO][pP]|[kK][eE][eE][pP]|[dD][eE][lL][eE][tT][eE]|[rR][eE][nN][aA][mM][eE]|[rR][eE][tT][aA][iI][nN]|[aA][rR][rR][aA][yY]|[sS][tT][oO][pP]|[dD][oO]|[eE][nN][dD]|[rR][uU][nN]|[lL][eE][nN][gG][tT][hH]|[aA][tT][tT][rR][iI][bB]|[fF][oO][rR][mM][aA][tT]|[lL][aA][bB][eE][lL]|[iI][nN][fF][oO][rR][mM][aA][tT])\b)[^;]*=[^;]*/

skipped_stmt: length_stmt
            | attrib_stmt
            | format_stmt
            | label_stmt
            | informat_stmt
            | call_stmt

length_stmt: /[lL][eE][nN][gG][tT][hH][^;]*/
attrib_stmt: /[aA][tT][tT][rR][iI][bB][^;]*/
format_stmt: /[fF][oO][rR][mM][aA][tT][^;]*/
label_stmt: /[lL][aA][bB][eE][lL][^;]*/
informat_stmt: /[iI][nN][fF][oO][rR][mM][aA][tT][^;]*/
call_stmt: /[cC][aA][lL][lL]\b[^;]*/

LINE_COMMENT: /\*(?!\/)[^;]*;/
BLOCK_COMMENT: /\/\*[\s\S]*?\*\//

%ignore LINE_COMMENT
%ignore BLOCK_COMMENT

%import common.WS
%ignore WS
