// limulus DataStep grammar 

start: statement (";" statement)* ";"?

statement: data_stmt
         | set_stmt
         | merge_stmt
         | if_stmt
         | else_if_stmt
         | else_stmt
         | where_stmt
         | by_stmt
         | output_stmt
         | drop_stmt
         | keep_stmt
         | delete_stmt
         | rename_stmt
         | retain_stmt
         | array_stmt
         | stop_stmt
         | do_stmt
         | end_stmt
         | run_stmt
         | sum_stmt
         | assign_stmt
         | skipped_stmt

// --- Core statements ---
data_stmt: data_kw dataset_ref+
set_stmt: set_kw set_component+
merge_stmt: merge_kw set_component+
data_kw: /(?ai:data)/
set_kw: /(?ai:set)/
merge_kw: /(?ai:merge)/
set_component: dataset_ref
          | set_statement_option
dataset_ref: dataset_name dataset_options?
dataset_name: /[A-Za-z_][\w\.]*/
dataset_options: "(" dataset_option+ ")"
// Dataset option boundaries are scanned by the Python parser with balanced
// parentheses and quoted/escaped literal handling.  This outer token only
// keeps the statement grammar permissive enough to identify one option group;
// it is deliberately not used as the option-value parser.
dataset_option: /[A-Za-z_][\w]*\s*=\s*(?:[^)\s]+(?:\s+[^)\s]+)*)/
set_statement_option: /((?ai:indsname|end))\s*=\s*[A-Za-z_][\w\.]*/

if_stmt: if_then_do_stmt
    | if_then_stmt
    | subset_if_stmt
else_if_stmt: else_if_then_do_stmt
         | else_if_then_stmt
if_then_do_stmt: /(?ai:if)\b[^;]*\b(?ai:then)\s+(?ai:do)\b[^;]*/
if_then_stmt: /(?ai:if)\b[^;]*\b(?ai:then)\b[^;]*/
subset_if_stmt: /(?ai:if)\b(?![^;]*\b(?ai:then)\b)[^;]*/
else_if_then_do_stmt: /(?ai:else)\s*(?ai:if)\b[^;]*\b(?ai:then)\s+(?ai:do)\b[^;]*/
else_if_then_stmt: /(?ai:else)\s*(?ai:if)\b[^;]*\b(?ai:then)\b[^;]*/
else_stmt: /(?ai:else)[^;]*/
where_stmt: /(?ai:where)[^;]*/
by_stmt: /(?ai:by)[^;]*/
output_stmt: /(?ai:output)[^;]*/
drop_stmt: /(?ai:drop)[^;]*/
keep_stmt: /(?ai:keep)[^;]*/
delete_stmt: /(?ai:delete)/
rename_stmt: /(?ai:rename)[^;]*/
retain_stmt: /(?ai:retain)[^;]*/
array_stmt: /(?ai:array)[^;]*/
stop_stmt: /(?ai:stop)/
do_stmt: /(?ai:do)/ /[^;]+/
end_stmt: /(?ai:end)/
run_stmt: /(?ai:run)/

sum_stmt: /(?!\s*(?ai:if|else|where|data|set|merge|by|output|drop|keep|delete|rename|retain|array|stop|do|end|run|length|attrib|format|label|informat)\b)[A-Za-z_][\w\.]*\s*\+\s*[^;]+/
assign_stmt: /(?!\s*(?ai:if|else|where|data|set|merge|by|output|drop|keep|delete|rename|retain|array|stop|do|end|run|length|attrib|format|label|informat)\b)[^;]*=[^;]*/

skipped_stmt: length_stmt
            | attrib_stmt
            | format_stmt
            | label_stmt
            | informat_stmt
            | call_stmt

length_stmt: /(?ai:length)[^;]*/
attrib_stmt: /(?ai:attrib)[^;]*/
format_stmt: /(?ai:format)[^;]*/
label_stmt: /(?ai:label)[^;]*/
informat_stmt: /(?ai:informat)[^;]*/
call_stmt: /(?ai:call)\b[^;]*/

LINE_COMMENT: /\*(?!\/)[^;]*;/
BLOCK_COMMENT: /\/\*[\s\S]*?\*\//

%ignore LINE_COMMENT
%ignore BLOCK_COMMENT

%import common.WS
%ignore WS
